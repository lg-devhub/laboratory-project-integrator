# Iniciar-Banco.ps1 gera .env com uma senha local aleatoria.
# A senha de conexao com PostgreSQL e diferente das senhas dos usuarios STOCKA.
POSTGRES_PASSWORD=substitua_por_uma_senha_local

# Acesso ao painel pgAdmin; nao sao contas da aplicacao STOCKA.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=substitua_por_uma_senha_local
