# Copie para .env nesta pasta backend. Nao versione o arquivo .env.
DB_URL=jdbc:postgresql://localhost:15432/stocka?connectTimeout=5&socketTimeout=10
DB_USER=stocka
# Use o mesmo valor de POSTGRES_PASSWORD do .env da raiz.
DB_PASSWORD=substitua_pela_senha_do_postgresql

# Para um PostgreSQL remoto, altere as tres variaveis conforme o provedor.
# No Supabase, obtenha a URL JDBC e o usuario na opcao Connect do projeto.
# Use SSL na conexao remota. Este backend nao utiliza Supabase Auth ou Data API.